      "match": "=>|\\|\\||!=|<>|<=|>=|<<|>>|[=<>+*\\/%&|^~!-]"
    },
    {
      "name": "punctuation.separator.googlesql",
      "match": "[,;]"
    },
    {
      "name": "punctuation.section.googlesql",
      "match": "[()\\[\\]{}]"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.googlesql",
